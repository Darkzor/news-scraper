# Copy this file to .env for local backend configuration.

NEWS_SCRAPER_APP_NAME="News Scraper API"
NEWS_SCRAPER_APP_VERSION=0.1.0
NEWS_SCRAPER_API_PREFIX=/api
NEWS_SCRAPER_BACKEND_HOST=127.0.0.1
NEWS_SCRAPER_BACKEND_PORT=8000
NEWS_SCRAPER_FRONTEND_PORT=5173
NEWS_SCRAPER_DATABASE_URL=sqlite:///./news_scraper.db
NEWS_SCRAPER_TIMEOUT_MS=15000
NEWS_SCRAPER_MAX_ARTICLES=20
NEWS_SCRAPER_RETRIES=1
